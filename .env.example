# ---------------------------------------------------------------- PubMed (NCBI)
# NCBI asks every E-utilities client to identify itself with an email address.
NCBI_EMAIL=you@example.com
# Optional: a free API key raises your rate limit from 3 to 10 requests/second.
NCBI_API_KEY=

# ---------------------------------------------------------------- LLM (the agent's brain)
# Providers are tried in this order; any without a key (and model) are skipped.
# Defaults below are the flagship models checked on 21 Oct 2026. Model names change often:
# run `python -m medperplexity llm-check` after editing, and re-check openrouter.ai/models.
LLM_PROVIDERS=openrouter,anthropic,openai,gemini
LLM_TIMEOUT_S=45

# 1) OpenRouter (primary).
OPENROUTER_API_KEY=
# Claude Opus 5.5: top of OpenRouter's intelligence ranking at the time of writing (about $4 / $20 per 1M tokens).
OPENROUTER_MODEL=anthropic/claude-opus-5.5
# OpenRouter itself tries these, in order, if the first model fails:
# OpenAI's flagship GPT-6 Astra, then Google's flagship Gemini 4 Argon (confirm the ID on openrouter.ai/models).
OPENROUTER_FALLBACK_MODELS=openai/gpt-6-astra,google/gemini-4-argon
# Privacy: only route to providers that do not store prompts (default "deny"). Set OPENROUTER_ZDR=true to also
# require zero-data-retention endpoints (the request fails over if none exists for a model).
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=false
# Optional, shown on OpenRouter's dashboards
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Med Perplexity

# 2) Claude directly (fallback if OpenRouter is down).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# 3) OpenAI directly (fallback).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# 4) Gemini directly (fallback). Needs a paid Google API tier.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-4-argon

# ---------------------------------------------------------------- Data locations (optional)
# PATIENTS_DB=data/patients.json
# MEDPERPLEXITY_DB=data/medicines.json
# MEDPERPLEXITY_TIMEOUT_S=25
# MEDPERPLEXITY_CACHE_TTL_S=3600
